{
  "collections": [
    {
      "name": "users",
      "description": "Stores user profiles including their role.",
      "fields": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "description": "'admin' or 'learner'" },
        "zone": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      }
    },
    {
      "name": "assessments",
      "description": "Stores assessments generated by admins.",
      "fields": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string", "description": "Admin User ID" },
        "createdAt": { "type": "timestamp" },
        "questions": { "type": "array" }
      }
    },
    {
      "name": "results",
      "description": "Stores assessment results submitted by learners.",
      "fields": {
        "userId": { "type": "string" },
        "assessmentId": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "delta": { "type": "number" },
        "submittedAt": { "type": "timestamp" }
      }
    }
  ]
}
